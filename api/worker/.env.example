# URL of the master deployment (Coolify-fronted public hostname).
MASTER_BASE_URL=https://api.example.com

# Must match WORKER_TOKEN in the master's .env.
WORKER_TOKEN=changeme-worker

# llama-server's API key (defense-in-depth — the agent talks to it on the docker network).
LLAMA_INTERNAL_KEY=changeme-llama-internal

# Identifies this worker to the master for per-worker concurrency accounting.
WORKER_ID=arc-pro-b50-01

# Slugs hosted on this worker. Must match section names in presets/himalaya.ini AND
# the master's MODEL_SLUGS.
MODEL_SLUGS=himalaya-bf16,himalaya-q8,himalaya-q4

# Worker-side concurrency cap. Must be ≤ `parallel` in himalaya.ini.
MAX_CONCURRENT=2

# < 60s to dodge Cloudflare's default 100s idle ceiling.
POLL_TIMEOUT_S=55

# --- GGUF source ---
# 1) Set MODELS_HOST_PATH to bind-mount a directory on the worker host that
#    already holds the three .gguf files (e.g. rsync'd there manually). The
#    init container will see them and skip downloading.
# MODELS_HOST_PATH=/home/lukashimsel/himalaya-models
#
# 2) Or leave MODELS_HOST_PATH unset; the init container will download the
#    GGUFs to a Docker named volume (himalaya-models-data) on first boot.
#    Override the source URL prefix via:
# MODELS_DOWNLOAD_BASE_URL=https://huggingface.co/lukas-h/himalayagpt-0.5b-it-gguf/resolve/main
