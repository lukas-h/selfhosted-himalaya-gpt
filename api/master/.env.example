# Comma-separated user-facing bearer tokens.
API_TOKENS=changeme1,changeme2

# Single shared secret for the worker → master internal channel.
WORKER_TOKEN=changeme-worker

# Slugs exposed at /v1/models — must match section names in worker/presets/himalaya.ini
MODEL_SLUGS=himalaya-bf16,himalaya-q8,himalaya-q4

# Concurrency caps. Match the worker-side MAX_CONCURRENT; the default worker
# has three single-parallel llama services, so total worker capacity is 3.
MAX_CONCURRENT_PER_WORKER=3
MAX_QUEUE_DEPTH=32

# Per-key (token-hashed) rate limit on /v1/chat/completions.
# RATE_LIMIT_RPM is the sustained per-minute cap (1200/min ≈ 20 req/s).
# RATE_LIMIT_BURST_RPS adds a per-second cap that absorbs brief spikes
# without letting a stuck client hammer; set to 0 to disable. Both apply
# simultaneously — the tighter one wins per request. Lower these if you
# expose API_TOKENS to untrusted clients.
RATE_LIMIT_RPM=1200
RATE_LIMIT_BURST_RPS=30

# Server-side timeouts (seconds). USER_REQUEST_TIMEOUT_S applies globally to
# every model slug and must cover queue wait + generation time.
USER_REQUEST_TIMEOUT_S=240
WORKER_POLL_TIMEOUT_S=55
